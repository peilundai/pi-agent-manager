{
  "name": "pi-agent-manager",
  "displayName": "Pi Chat",
  "description": "Chat with your local Pi coding agent from VS Code's side bar, Claude Code style.",
  "version": "0.2.0",
  "publisher": "peilun-dai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peilundai/pi-agent-manager.git"
  },
  "homepage": "https://github.com/peilundai/pi-agent-manager#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "pi",
    "coding agent",
    "ai",
    "chat",
    "assistant"
  ],
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi Chat launches the local pi executable and reads workspace-scoped Pi session files."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piChat.open",
        "title": "Open Pi Chat",
        "category": "Pi",
        "icon": "media/pi.svg"
      },
      {
        "command": "piChat.newChat",
        "title": "New Chat",
        "category": "Pi",
        "icon": "$(add)"
      },
      {
        "command": "piChat.history",
        "title": "Past Chats",
        "category": "Pi",
        "icon": "$(history)"
      },
      {
        "command": "piChat.sendSelection",
        "title": "Add Selection to Pi Chat",
        "category": "Pi"
      },
      {
        "command": "piChat.focusInput",
        "title": "Focus Pi Chat Input",
        "category": "Pi"
      }
    ],
    "keybindings": [
      {
        "command": "piChat.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "piChat.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "piChat.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "piChat.focused"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "piChat",
          "title": "Pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piChat": [
        {
          "type": "webview",
          "id": "piChat.view",
          "name": "Pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "piChat.open",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "piChat.sendSelection",
          "group": "pi@1",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Pi Chat",
      "properties": {
        "piChat.command": {
          "type": "string",
          "default": "pi",
          "description": "Executable name or absolute path of the Pi CLI."
        },
        "piChat.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `pi --mode rpc` (for example `--offline` or `--provider anthropic`). Session and mode flags are managed by the extension."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "npm run build && playwright test",
    "test:all": "npm run test:coverage && npm run test:e2e && npm run test:ui",
    "package": "npm run check && npm test && npm run build && node scripts/package-vsix.mjs",
    "verify:package": "node scripts/verify-vsix.mjs"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "highlight.js": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "3.2.7",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yauzl": "^3.4.0"
  }
}
