{
  "name": "pi-agent-manager",
  "displayName": "Pi Agent Manager",
  "description": "Unofficial side-bar chat for the Pi coding agent. Runs your locally installed and configured pi CLI.",
  "version": "0.2.0",
  "publisher": "peilun-dai",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/peilundai/pi-agent-manager.git"
  },
  "homepage": "https://github.com/peilundai/pi-agent-manager#readme",
  "bugs": {
    "url": "https://github.com/peilundai/pi-agent-manager/issues"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "pi",
    "pi coding agent",
    "coding agent",
    "ai",
    "chat",
    "agent",
    "unofficial"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi Agent Manager launches the local pi executable and reads workspace-scoped Pi session files."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piAgentManager.open",
        "title": "Open",
        "category": "Pi Agent Manager",
        "icon": {
          "light": "media/pi-light.svg",
          "dark": "media/pi-dark.svg"
        }
      },
      {
        "command": "piAgentManager.newChat",
        "title": "New Chat",
        "category": "Pi Agent Manager",
        "icon": "$(add)"
      },
      {
        "command": "piAgentManager.history",
        "title": "Past Chats",
        "category": "Pi Agent Manager",
        "icon": "$(history)"
      },
      {
        "command": "piAgentManager.sendSelection",
        "title": "Add Selection to Chat",
        "category": "Pi Agent Manager"
      },
      {
        "command": "piAgentManager.focusInput",
        "title": "Focus Chat Input",
        "category": "Pi Agent Manager"
      },
      {
        "command": "piAgentManager.switchFolder",
        "title": "Switch Workspace Folder",
        "category": "Pi Agent Manager",
        "icon": "$(folder)",
        "enablement": "workspaceFolderCount > 1"
      },
      {
        "command": "piAgentManager.setEnvironmentSecret",
        "title": "Set Environment Secret…",
        "category": "Pi Agent Manager"
      },
      {
        "command": "piAgentManager.removeEnvironmentSecret",
        "title": "Remove Environment Secret…",
        "category": "Pi Agent Manager"
      },
      {
        "command": "piAgentManager.reloadEnvironment",
        "title": "Reload Environment and Restart Pi",
        "category": "Pi Agent Manager"
      },
      {
        "command": "piAgentManager.showEnvironmentDiagnostics",
        "title": "Show Environment Diagnostics",
        "category": "Pi Agent Manager"
      }
    ],
    "keybindings": [
      {
        "command": "piAgentManager.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "piAgentManager.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "piAgentManager.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "piAgentManager.focused"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "piAgentManager",
          "title": "Pi Agent Manager",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piAgentManager": [
        {
          "type": "webview",
          "id": "piAgentManager.view",
          "name": "Chat",
          "icon": "media/pi.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "piAgentManager.open",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "piAgentManager.switchFolder",
          "when": "workspaceFolderCount > 1"
        }
      ],
      "editor/context": [
        {
          "command": "piAgentManager.sendSelection",
          "group": "pi@1",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Pi Agent Manager",
      "properties": {
        "piAgentManager.command": {
          "type": "string",
          "default": "pi",
          "description": "Executable name or absolute path of the Pi CLI."
        },
        "piAgentManager.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `pi --mode rpc` (for example `--offline` or `--provider anthropic`). Session and mode flags are managed by the extension."
        },
        "piAgentManager.expandToolCards": {
          "type": "string",
          "enum": [
            "edits",
            "all",
            "none"
          ],
          "enumDescriptions": [
            "Expand edits and writes to show their diff; fold other tools.",
            "Expand every tool card.",
            "Fold every tool card, showing only its header and summary."
          ],
          "default": "edits",
          "markdownDescription": "Which tool cards in the chat start expanded. Click a card's header to expand or fold it."
        },
        "piAgentManager.loadShellEnvironment": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Start Pi with the variables your login shell sets up (API keys, company gateway settings, MCP tokens, `PATH`), even when VS Code was not started from a terminal. Variables VS Code already has are kept. Not used on Windows."
        },
        "piAgentManager.environment": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Extra environment variables for Pi, such as a gateway base URL. Do not put API keys here; use **Pi Agent Manager: Set Environment Secret…**, which stores them encrypted."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "npm run build && playwright test",
    "test:all": "npm run test:coverage && npm run test:e2e && npm run test:ui",
    "package": "npm run check && npm test && npm run build && node scripts/package-vsix.mjs",
    "verify:package": "node scripts/verify-vsix.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "highlight.js": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "ovsx": "^1.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yauzl": "^3.4.0"
  }
}
